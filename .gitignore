__pycache__/
*.py[cod]
.DS_Store
# Local scan secrets must never be committed; the canonical location is
# ~/.config/agent-orch/lint.secrets, outside the repository.
*.secrets
# ...except the test fixture, which holds only synthetic values and has to be
# present for the scanner's own tests to run in a fresh clone.
!tools/tests/fixtures/secrets-example.secrets
# Runtime state of a local orchestrator home.
/orch-home/
/output/
# OpenSpec working artifacts can contain deployment paths, task IDs, and
# operator evidence. Public design decisions belong in docs/ after sanitizing.
/openspec/
.containment-test-*/
.sbtest-*/

# Real target packages are not tracked here: a target names another project's
# paths and vocabulary, and keeping those out is what lets the engine stay
# target-agnostic (D-2026-09-15-01). `_fixture_min` is the exception on purpose
# - it belongs to no project and exists to prove that independence, so it ships
# with the engine and its tests. Engine tests skip when a target is absent.
/targets/*
!/targets/_fixture_min/
