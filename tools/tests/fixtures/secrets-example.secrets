# Example secrets file. Synthetic values — the real one is never committed.
# Syntax:
#   <id>=<literal>      literal is regex-escaped before matching
#   <id>~=<regex>       value is used as a regex verbatim
# <id> must equal (or be prefixed by) the id of a requires_secrets rule in
# risk-patterns.yaml, e.g. `company_domain.primary=...`.
person_name=Casey Doe
company_domain~=(?:acme-internal\.test|acmeproj)
