# Shared ORCH_* definitions, sourced by BOTH packaging/orch and
# packaging/run-daemon.sh — one file, so the CLI and the daemon cannot resolve
# a different ORCH_HOME and quietly operate on two different states.
#
# This is a template: copy it to ~/.config/agent-orch/env.sh (or point
# AGENT_ORCH_ENV at your copy) and fill in the values. Keep your copy outside
# version control. Variables already set in the environment win over this file.
#
# Alternatively, the same variables can live in the TOML config file the CLI
# loads itself (~/.config/agent-orch/orch.toml, or ORCH_CONFIG) — but the
# daemon launcher reads only this shell file, so a daemon deployment belongs
# here.

# Every assignment uses ${VAR-default} (no colon), so a variable already SET
# by the service manager or the calling shell keeps its value even when it is
# set to empty — an empty ORCH_PROTECTED_ROOTS is a deliberate "L2 off", not
# an invitation to substitute the default. Matches the TOML layer's
# "the environment always wins" rule.

# Where state and evidence live. Without it the CLI defaults to a directory
# under the repository — legal, but almost never what a daemon deployment means.
# Keep it OUTSIDE every protected root: stage logs and reports are written
# here, and a protected root covering it would make L2 flag the engine itself.
export ORCH_HOME="${ORCH_HOME-$HOME/.local/state/agent-orch}"

# Model pins, required by run-daemon.sh. Deliberately NOT pre-filled: a value
# copied from a template would satisfy the launcher's required-check while
# pinning a model nobody chose. Uncomment and pick your own.
# export ORCH_CLAUDE_MODEL="${ORCH_CLAUDE_MODEL-<pick-a-model>}"
# export ORCH_CODEX_MODEL="${ORCH_CODEX_MODEL-<pick-a-model>}"

# L2 detection: what a stage must never modify. Deliberately empty here — a
# placeholder path that does not exist on your machine would read as "L2 is
# on" while the sentinel silently skips it (`orch doctor` now fails on such
# roots, but do not rely on remembering to run it). Name real directories.
export ORCH_PROTECTED_ROOTS="${ORCH_PROTECTED_ROOTS-}"

# Optional: directories a stage may write beyond its workspace (a build cache,
# a package store). Must not overlap ORCH_PROTECTED_ROOTS.
# export ORCH_EXTRA_WRITE_ROOTS="${ORCH_EXTRA_WRITE_ROOTS-}"

# Optional: a deployment's own stage machines and risk vocabulary.
# export ORCH_PROFILES_DIR="${ORCH_PROFILES_DIR-$HOME/my-deployment/profiles}"
# export ORCH_RISK_RULES="${ORCH_RISK_RULES-$HOME/.config/agent-orch/risk-rules.yaml}"

# Deliberately NOT here: ORCH_ALLOW_UNATTENDED and ORCH_ALLOW_UNSANDBOXED are
# acknowledgements of per-deployment decisions. Set them where the decision is
# made (the service definition, or the shell of whoever is deciding), not in a
# file that gets copied between machines.
